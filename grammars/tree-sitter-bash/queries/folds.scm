; Fold ranges for mep's Bash grammar.
[
  (function_definition)
  (compound_statement)
  (subshell)
  (if_statement)
  (elif_clause)
  (else_clause)
  (case_statement)
  (case_item)
  (for_statement)
  (c_style_for_statement)
  (while_statement)
  (do_group)
  (heredoc_body)
  (array)
  (command_substitution)
] @fold
