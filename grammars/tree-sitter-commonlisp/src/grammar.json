{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "commonlisp",
  "rules": {
    "source": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "shebang"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "shebang": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "#![^\\n]*"
        }
      }
    },
    "_form": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "vector"
        },
        {
          "type": "SYMBOL",
          "name": "quote"
        },
        {
          "type": "SYMBOL",
          "name": "quasiquote"
        },
        {
          "type": "SYMBOL",
          "name": "unquote"
        },
        {
          "type": "SYMBOL",
          "name": "unquote_splicing"
        },
        {
          "type": "SYMBOL",
          "name": "function"
        },
        {
          "type": "SYMBOL",
          "name": "read_eval"
        },
        {
          "type": "SYMBOL",
          "name": "feature_expression"
        },
        {
          "type": "SYMBOL",
          "name": "label"
        },
        {
          "type": "SYMBOL",
          "name": "label_reference"
        },
        {
          "type": "SYMBOL",
          "name": "array"
        },
        {
          "type": "SYMBOL",
          "name": "structure"
        },
        {
          "type": "SYMBOL",
          "name": "complex"
        },
        {
          "type": "SYMBOL",
          "name": "pathname"
        },
        {
          "type": "SYMBOL",
          "name": "bit_vector"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "character"
        },
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "uninterned_symbol"
        },
        {
          "type": "SYMBOL",
          "name": "qualified_symbol"
        },
        {
          "type": "SYMBOL",
          "name": "package_form"
        },
        {
          "type": "SYMBOL",
          "name": "symbol"
        }
      ]
    },
    "list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_form"
              },
              {
                "type": "SYMBOL",
                "name": "dot"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "dot": {
      "type": "STRING",
      "value": "."
    },
    "vector": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "#\\d*\\("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "quote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "quasiquote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "`"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "unquote": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "unquote_splicing": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ",@"
            },
            {
              "type": "STRING",
              "value": ",."
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "function": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#'"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "read_eval": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#."
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "feature_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "operator",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "#+"
              },
              {
                "type": "STRING",
                "value": "#-"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "feature",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "label": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "#\\d+="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "label_reference": {
      "type": "PATTERN",
      "value": "#\\d+#"
    },
    "array": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "#\\d*[aA]"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "structure": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "#[sS]"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "list"
          }
        }
      ]
    },
    "complex": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "#[cC]"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "list"
          }
        }
      ]
    },
    "pathname": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "#[pP]"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        }
      ]
    },
    "bit_vector": {
      "type": "PATTERN",
      "value": "#\\*[01]*"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[+-]?(\\d+\\.?|\\d+\\/\\d+|\\d*\\.\\d+([eEsSfFdDlL][+-]?\\d+)?|\\d+(\\.\\d*)?[eEsSfFdDlL][+-]?\\d+)"
          },
          {
            "type": "PATTERN",
            "value": "#([bB][+-]?[01]+(\\/[01]+)?|[oO][+-]?[0-7]+(\\/[0-7]+)?|[xX][+-]?[0-9a-fA-F]+(\\/[0-9a-fA-F]+)?|\\d+[rR][+-]?[0-9a-zA-Z]+(\\/[0-9a-zA-Z]+)?)"
          }
        ]
      }
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_string_content"
              },
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              },
              {
                "type": "SYMBOL",
                "name": "format_directive"
              }
            ]
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "\""
          }
        }
      ]
    },
    "escape_sequence": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\\\(.|\\n)"
      }
    },
    "format_directive": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "~([0-9vV#,]|'.)*[:@]*[^\"\\\\]"
      }
    },
    "character": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#\\"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\\n]"
              },
              {
                "type": "PATTERN",
                "value": "[a-zA-Z][a-zA-Z0-9_+-]+"
              }
            ]
          }
        ]
      }
    },
    "keyword": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "::?"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\\s()'\"`,;|\\\\:]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\[^\\n]|\\|[^|]*\\|"
                }
              ]
            }
          }
        ]
      }
    },
    "uninterned_symbol": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#:"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\\s()'\"`,;|\\\\:]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\[^\\n]|\\|[^|]*\\|"
                }
              ]
            }
          }
        ]
      }
    },
    "qualified_symbol": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "package",
          "content": {
            "type": "SYMBOL",
            "name": "_package"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "REPEAT1",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^\\s()'\"`,;|\\\\:]"
                    },
                    {
                      "type": "PATTERN",
                      "value": "\\\\[^\\n]|\\|[^|]*\\|"
                    }
                  ]
                }
              }
            },
            "named": true,
            "value": "symbol"
          }
        }
      ]
    },
    "package_form": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "package",
          "content": {
            "type": "SYMBOL",
            "name": "_package"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "list"
          }
        }
      ]
    },
    "_package": {
      "type": "ALIAS",
      "content": {
        "type": "TOKEN",
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^\\s()'\"`,;|\\\\:#]"
                    },
                    {
                      "type": "PATTERN",
                      "value": "\\\\[^\\n]|\\|[^|]*\\|"
                    }
                  ]
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "PATTERN",
                        "value": "[^\\s()'\"`,;|\\\\:]"
                      },
                      {
                        "type": "PATTERN",
                        "value": "\\\\[^\\n]|\\|[^|]*\\|"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "PATTERN",
              "value": "::?"
            }
          ]
        }
      },
      "named": true,
      "value": "package"
    },
    "symbol": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\\s()'\"`,;|\\\\:#]"
              },
              {
                "type": "PATTERN",
                "value": "\\\\[^\\n]|\\|[^|]*\\|"
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\\s()'\"`,;|\\\\:]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\[^\\n]|\\|[^|]*\\|"
                }
              ]
            }
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ";"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "block_comment"
    },
    {
      "type": "SYMBOL",
      "name": "_string_content"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}