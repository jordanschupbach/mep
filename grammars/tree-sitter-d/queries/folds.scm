; Fold ranges for mep's D grammar: bodies and literals that span lines
; (aggregate, function, template and block bodies, enum bodies, switch
; cases, contracts, array literals and argument lists, token strings and
; comments).
[
  (aggregate_body)
  (block_statement)
  (enum_declaration)
  (anonymous_enum_declaration)
  (template_declaration)
  (conditional_declaration)
  (static_foreach_declaration)
  (case_statement)
  (in_statement)
  (out_statement)
  (array_literal)
  (aggregate_initializer)
  (arguments)
  (named_arguments)
  (parameters)
  (token_string)
  (asm_statement)
  (import_declaration)
  (comment)
] @fold
