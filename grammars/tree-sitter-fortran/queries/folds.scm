; Fold ranges: program units, procedures, interface blocks, derived types
; and the executable constructs (the old grammar's folds.scm, plus the
; units and constructs it left out).
[
 (program)
 (module)
 (submodule)
 (function)
 (subroutine)
 (module_procedure)
 (interface)
 (derived_type_definition)
 (enum)
 (if_statement)
 (where_statement)
 (enum_statement)
 (do_loop_statement)
 (select_case_statement)
 (select_type_statement)
 (select_rank_statement)
 (associate_statement)
 (block_construct)
 (forall_statement)
] @fold
