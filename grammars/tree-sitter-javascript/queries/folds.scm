; Blocks and their clauses, definitions, bracketed literals and argument or
; parameter lists, imports, templates, comments and JSX elements; mep
; folds only the captures that span more than one row.
[
  (function_declaration)
  (function_expression)
  (arrow_function)
  (generator_function)
  (generator_function_declaration)
  (method_definition)
  (class_body)
  (class_static_block)
  (statement_block)
  (switch_body)
  (switch_case)
  (switch_default)
  (catch_clause)
  (finally_clause)
  (else_clause)
  (object)
  (object_pattern)
  (array)
  (array_pattern)
  (arguments)
  (formal_parameters)
  (named_imports)
  (export_clause)
  (template_string)
  (parenthesized_expression)
  (comment)
  (jsx_element)
  (jsx_self_closing_element)
  (jsx_expression)
] @fold
