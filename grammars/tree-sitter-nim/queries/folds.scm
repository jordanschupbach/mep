; Fold ranges for mep's Nim grammar: routine and block bodies, sections
; (type/const/let/var), object and enum bodies, branches of if/when/case/
; try, and literals or argument lists that span lines.
[
  (proc_declaration)
  (func_declaration)
  (method_declaration)
  (iterator_declaration)
  (converter_declaration)
  (template_declaration)
  (macro_declaration)
  (proc_expression)
  (func_expression)
  (iterator_expression)
  (do_block)
  (type_section)
  (const_section)
  (let_section)
  (var_section)
  (using_section)
  (type_declaration)
  (object_declaration)
  (enum_declaration)
  (concept_declaration)
  (variant_declaration)
  (of_branch)
  (elif_branch)
  (else_branch)
  (except_branch)
  (finally_branch)
  (if)
  (when)
  (case)
  (try)
  (for)
  (while)
  (block)
  (static_statement)
  (defer)
  (argument_list)
  (array_construction)
  (tuple_construction)
  (curly_construction)
  (parameter_declaration_list)
  (long_string_literal)
  (block_comment)
  (block_documentation_comment)
] @fold
