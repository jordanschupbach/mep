; Definitions, module bodies, matches and bracketed literals; mep folds
; only the captures that span more than one row.
[
  (value_definition)
  (type_definition)
  (exception_definition)
  (external)
  (value_specification)
  (module_definition)
  (module_type_definition)
  (class_definition)
  (class_type_definition)
  (structure)
  (signature)
  (object_expression)
  (method_definition)
  (match_expression)
  (function_expression)
  (try_expression)
  (match_case)
  (if_expression)
  (then_clause)
  (else_clause)
  (for_expression)
  (while_expression)
  (let_expression)
  (fun_expression)
  (parenthesized_expression)
  (list_expression)
  (array_expression)
  (record_expression)
  (record_declaration)
  (variant_declaration)
  (comment)
  (string)
  (quoted_string)
] @fold
