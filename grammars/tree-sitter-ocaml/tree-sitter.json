{
  "grammars": [
    {
      "name": "ocaml",
      "camelcase": "OCaml",
      "scope": "source.ocaml",
      "path": ".",
      "external-files": ["common/scanner.h"],
      "file-types": ["ml"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(ocaml|ml)$"
    }
  ],
  "metadata": {
    "version": "0.26.0",
    "license": "MIT",
    "description": "OCaml grammar for tree-sitter (tree-sitter/tree-sitter-ocaml, vendored in mep)",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-ocaml"
    }
  }
}
