; Specifications, signatures and declarations; mep folds only the captures
; that span more than one row.
[
  (value_specification)
  (external)
  (type_definition)
  (exception_definition)
  (module_definition)
  (module_type_definition)
  (class_definition)
  (class_type_definition)
  (signature)
  (record_declaration)
  (variant_declaration)
  (comment)
] @fold
