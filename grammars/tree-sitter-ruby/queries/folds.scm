; Definitions, compound statements and their clauses, blocks, and any
; literal or argument list spanning lines; mep folds only the captures that
; span more than one row.
[
  (module)
  (class)
  (singleton_class)
  (method)
  (singleton_method)
  (begin)
  (if)
  (unless)
  (elsif)
  (else)
  (case)
  (case_match)
  (when)
  (in_clause)
  (while)
  (until)
  (for)
  (rescue)
  (ensure)
  (do_block)
  (block)
  (lambda)
  (hash)
  (array)
  (string_array)
  (symbol_array)
  (argument_list)
  (method_parameters)
  (heredoc_body)
  (begin_block)
  (end_block)
] @fold
