diff -ruN a/nix/datamungeguile.nix b/nix/datamungeguile.nix
--- a/nix/datamungeguile.nix	2026-10-12 16:38:51.219942614 -0600
+++ b/nix/datamungeguile.nix	2026-10-12 16:38:51.243942843 -0600
@@ -4,6 +4,11 @@
 
 let
   datamunge = import ./datamunge.nix { inherit pkgs; };
+  # Only used inside the runtime `uname = Darwin` branch of installPhase,
+  # but Nix string interpolation forces the derivation at eval time on
+  # every host, and nixpkgs marks cctools as Darwin-only -- so gate the
+  # reference itself (empty string on Linux, where it is never run).
+  installNameTool = pkgs.lib.optionalString pkgs.stdenv.hostPlatform.isDarwin "${pkgs.darwin.cctools}/bin/install_name_tool";
 in
 pkgs.stdenv.mkDerivation rec {
   pname = "datamungeguile";
@@ -65,7 +70,7 @@
